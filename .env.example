# Copy to .env and fill in. The extraction pipeline (ehr.pipeline) reads these at startup.
# .env itself is gitignored; this template is safe to commit.

INPUT_DIR="./input"
OUTPUT_DIR="./output"
DB_PATH="checkpoints.sqlite"
MAX_RETRIES="3"
LLM_BASE_URL="http://localhost:8000/v1"
LLM_API_KEY="your-local-api-key"
LLM_MODEL="gpt-oss"
